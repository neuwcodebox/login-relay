{
  "name": "login-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc && esbuild src/browser.ts --bundle --platform=browser --format=iife --target=firefox128 --minify --outfile=dist/public/form.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
